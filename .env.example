# ShreeAgent AI configuration
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Everything is optional except ANTHROPIC_API_KEY (for the agent chat). Missing keys turn off only the feature that needs them.

# ---------------- LLM (agent chat) ----------------
# anthropic | openai_compat
LLM_PROVIDER=anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Default model for chat, and the model used by the "Deep mode" toggle
LLM_MODEL=claude-sonnet-5-5
LLM_DEEP_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower, more tokens)
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Only for LLM_PROVIDER=openai_compat (also run: pip install openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------------- Market data ----------------
# Primary + fallback price providers: yfinance (no key) | twelvedata
PRICE_PROVIDER=yfinance
PRICE_FALLBACK_PROVIDER=twelvedata
# https://twelvedata.com/account/api-keys  (free: 8 req/min, 800/day)
TWELVEDATA_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys  (free: macro data + US release calendar)
FRED_API_KEY=
# https://finnhub.io/dashboard  (free: company news, peers, earnings calendar)
FINNHUB_API_KEY=
# https://www.marketaux.com/account/dashboard  (free: 100 req/day, news with sentiment, covers India)
MARKETAUX_API_KEY=

# ---------------- Forecasting (TimesFM-3) ----------------
# timesfm | naive
FORECAST_MODEL=timesfm
TIMESFM_CHECKPOINT=google/timesfm-3.0-pytorch
# auto | cpu | cuda | mps
TIMESFM_DEVICE=auto
TIMESFM_BATCH_SIZE=8
TIMESFM_CONTEXT_LENGTH=1024
FORECAST_HORIZONS=5,10,30
# Hugging Face token: only needed if the model download asks for authentication
HF_TOKEN=

# ---------------- News sentiment ----------------
# finbert (local model, ~440 MB download) | lexicon (no download)
SENTIMENT_MODEL=finbert

# ---------------- WhatsApp alerts ----------------
# callmebot | twilio | none
WHATSAPP_BACKEND=none
# CallMeBot (free, personal): your number with country code, e.g. +919876543210
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
# Twilio (official, paid after trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=
# Daily scan time (Mon-Fri) and timezone
SCAN_TIME=08:00
SCAN_TIMEZONE=Asia/Kolkata
# Include a TimesFM forecast in the scan (slower)
SCAN_INCLUDE_FORECAST=false
# Combined score (0-100) at or above which a symbol is flagged as a strong signal
ALERT_SCORE_THRESHOLD=40

# ---------------- Signals tab (beginner BUY / SELL / WAIT cards) ----------------
# All optional: the defaults below are used if you leave them out.
# Chart the entry / stop / targets are built on, and the TimesFM forecast length (candles) used in the decision
SIGNAL_TIMEFRAME=1d
SIGNAL_FORECAST_HORIZON=10
# Include the TimesFM forecast in every card (about 4 s per symbol on CPU, cached)
SIGNAL_INCLUDE_FORECAST=true
# Only BUY/SELL when the reward to target 1 is at least this many times the risk (1.5 = risk 1 to make 1.5)
SIGNAL_MIN_RR=1.5
# Combined score (0-100) needed to suggest a direction, and to call it High confidence
SIGNAL_MIN_SCORE=25
SIGNAL_HIGH_SCORE=50
# Low | Medium | High: anything below this confidence becomes WAIT
SIGNAL_MIN_CONFIDENCE=Medium
# WAIT if a major event (CPI, jobs report, central bank) is today or within N days; warn for events within N days
SIGNAL_EVENT_BLACKOUT_DAYS=1
SIGNAL_EVENT_WARNING_DAYS=7
# Stocks: WAIT if the company reports earnings within N days
SIGNAL_EARNINGS_BLACKOUT_DAYS=3
# WAIT if a safe stop would have to be more than N normal daily ranges away
SIGNAL_MAX_STOP_ATR=3.0
# Trading days a BUY/SELL stays valid if you haven't entered yet
SIGNAL_EXPIRY_BARS=3
# Reuse stored signals younger than this (minutes); the Refresh button always re-runs
SIGNAL_REFRESH_MINUTES=60
# true = let the LLM reword the explanations (uses ANTHROPIC_API_KEY; numbers are locked and checked)
SIGNAL_LLM_POLISH=false

# ---------------- Position size helper (defaults; you can change them in the app) ----------------
ACCOUNT_SIZE=1000
ACCOUNT_CURRENCY=EUR
RISK_PER_TRADE_PCT=1.0
# XTB / EU retail rules for major forex pairs: leverage 1:30, 1 lot = 100,000 units, smallest trade 0.01 lots
LEVERAGE=30
FX_LOT_SIZE=100000
FX_MIN_LOT=0.01
# Typical EUR/USD spread in pips, added to the stop loss so the spread alone can't trigger it
SPREAD_PIPS=1.0

# ---------------- Misc ----------------
LOG_LEVEL=INFO
