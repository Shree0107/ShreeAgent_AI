# ShreeAgent AI configuration
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Everything is optional except ANTHROPIC_API_KEY (for the agent chat). Missing keys turn off only the feature that needs them.

# ---------------- LLM (agent chat) ----------------
# anthropic | openai_compat
LLM_PROVIDER=anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Default model for chat, and the model used by the "Deep mode" toggle
LLM_MODEL=claude-sonnet-5-5
LLM_DEEP_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower, more tokens)
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Only for LLM_PROVIDER=openai_compat (also run: pip install openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------------- Market data ----------------
# Primary + fallback price providers: yfinance (no key) | twelvedata
PRICE_PROVIDER=yfinance
PRICE_FALLBACK_PROVIDER=twelvedata
# https://twelvedata.com/account/api-keys  (free: 8 req/min, 800/day)
TWELVEDATA_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys  (free: macro data + US release calendar)
FRED_API_KEY=
# https://finnhub.io/dashboard  (free: company news, peers, earnings calendar)
FINNHUB_API_KEY=
# https://www.marketaux.com/account/dashboard  (free: 100 req/day, news with sentiment, covers India)
MARKETAUX_API_KEY=

# ---------------- Live prices (new web app) ----------------
# OANDA practice (demo) account: free real-time forex & gold prices, bid/ask spread, years of 1-minute history.
# Create a demo account at https://www.oanda.com, then: My Account -> Manage API Access -> Generate token.
# Without a token, forex prices come from Yahoo and are labelled "Delayed".
OANDA_API_TOKEN=
# Optional: found automatically from the token when empty
OANDA_ACCOUNT_ID=
# practice (demo account) | live (real-money account token)
OANDA_ENVIRONMENT=practice
# Stream / poll prices for open charts and the watchlist
LIVE_ENABLED=true
# How often symbols without a stream (stocks, or forex without OANDA) are polled, in seconds
LIVE_POLL_SECONDS=15
# No new price for this many seconds while the market is open -> shown as "Stale"
STALE_AFTER_SECONDS=60

# ---------------- Forecasting (TimesFM-3) ----------------
# timesfm | naive
FORECAST_MODEL=timesfm
TIMESFM_CHECKPOINT=google/timesfm-3.0-pytorch
# auto | cpu | cuda | mps
TIMESFM_DEVICE=auto
TIMESFM_BATCH_SIZE=8
TIMESFM_CONTEXT_LENGTH=1024
FORECAST_HORIZONS=5,10,30
# Forecast tab (phase 9): candles ahead per timeframe; related series kept only if they help (auto|on|off)
FORECAST_TAB_HORIZONS=15m:16,1h:24,4h:30,1d:10
FORECAST_MULTIVARIATE=auto
FORECAST_CHECK_HOURS=24
FORECAST_CHECK_WINDOWS=20
FORECAST_WATCH_MINUTES=120
# Hugging Face token: only needed if the model download asks for authentication
HF_TOKEN=

# ---------------- News sentiment ----------------
# finbert (local model, ~440 MB download) | lexicon (no download)
SENTIMENT_MODEL=finbert

# ---------------- WhatsApp alerts ----------------
# callmebot | twilio | none
WHATSAPP_BACKEND=none
# CallMeBot (free, personal): your number with country code, e.g. +919876543210
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
# Twilio (official, paid after trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=
# Daily scan time (Mon-Fri) and timezone
SCAN_TIME=08:00
SCAN_TIMEZONE=Asia/Kolkata
# Include a TimesFM forecast in the scan (slower)
SCAN_INCLUDE_FORECAST=false
# Combined score (0-100) at or above which a symbol is flagged as a strong signal
ALERT_SCORE_THRESHOLD=40

# ---------------- Signals tab (beginner BUY / SELL / WAIT cards) ----------------
# All optional: the defaults below are used if you leave them out.
# Chart the entry / stop / targets are built on, and the TimesFM forecast length (candles) used in the decision
SIGNAL_TIMEFRAME=1d
SIGNAL_FORECAST_HORIZON=10
# Include the TimesFM forecast in every card (about 4 s per symbol on CPU, cached)
SIGNAL_INCLUDE_FORECAST=true
# Only BUY/SELL when the reward to target 1 is at least this many times the risk (1.5 = risk 1 to make 1.5)
SIGNAL_MIN_RR=1.5
# Combined score (0-100) needed to suggest a direction, and to call it High confidence
SIGNAL_MIN_SCORE=25
SIGNAL_HIGH_SCORE=50
# Low | Medium | High: anything below this confidence becomes WAIT
SIGNAL_MIN_CONFIDENCE=Medium
# WAIT if a major event (CPI, jobs report, central bank) is today or within N days; warn for events within N days
SIGNAL_EVENT_BLACKOUT_DAYS=1
SIGNAL_EVENT_WARNING_DAYS=7
# Stocks: WAIT if the company reports earnings within N days
SIGNAL_EARNINGS_BLACKOUT_DAYS=3
# WAIT if a safe stop would have to be more than N normal daily ranges away
SIGNAL_MAX_STOP_ATR=3.0
# Trading days a BUY/SELL stays valid if you haven't entered yet
SIGNAL_EXPIRY_BARS=3
# Reuse stored signals younger than this (minutes); the Refresh button always re-runs
SIGNAL_REFRESH_MINUTES=60
# true = let the LLM reword the explanations (uses ANTHROPIC_API_KEY; numbers are locked and checked)
SIGNAL_LLM_POLISH=false

# ---------------- Position size helper (defaults; you can change them in the app) ----------------
ACCOUNT_SIZE=1000
ACCOUNT_CURRENCY=EUR
RISK_PER_TRADE_PCT=1.0
# XTB / EU retail rules for major forex pairs: leverage 1:30, 1 lot = 100,000 units, smallest trade 0.01 lots
LEVERAGE=30
FX_LOT_SIZE=100000
FX_MIN_LOT=0.01
# Typical EUR/USD spread in pips, added to the stop loss so the spread alone can't trigger it
SPREAD_PIPS=1.0

# ---------------- Trade-plan alerts (Telegram + browser) ----------------
# Telegram: in the Telegram app talk to @BotFather -> /newbot -> paste the token here. Then send any message to
# your new bot and run:  python -m alerts.telegram --chat-id   (prints your chat id)   and  --test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which events alert you: get_ready, entry_triggered, tp_hit, sl_hit, breakeven, time_stop, cancelled, expired, or all
ALERT_EVENTS=get_ready,entry_triggered,tp_hit,sl_hit,cancelled
# Don't repeat the same alert for the same plan within this many minutes
ALERT_DEDUPE_MINUTES=30
# Also send trade-plan alerts to WhatsApp (uses WHATSAPP_BACKEND above)
ALERTS_WHATSAPP=false
# Browser/desktop notifications need no setting: click the bell in the top bar and allow notifications.

# ---------------- Intraday (phase 6): Trade Plan tab, 15-minute engine ----------------
# Main trading chart; daily + 4-hour = big picture, 1-hour = today's trend and zones, 5-minute = entry timing
INTRADAY_TIMEFRAME=15m
# BUY/SELL only when reward/risk to target 1 is at least this, and at least N independent checks agree
INTRADAY_MIN_RR=1.5
INTRADAY_MIN_CONFIRMATIONS=3
# No new signals this many minutes before and after high-impact news (ForexFactory calendar)
NEWS_BLACKOUT_MINUTES=30
# Cut-off times below are in this time zone (XTB uses CET/CEST)
SESSION_TIMEZONE=Europe/Berlin
NO_NEW_ENTRIES_AFTER=18:00
FLAT_BY=21:30
# Move the stop loss to the entry price once the trade is up this many times the risk
BREAKEVEN_AT_R=1.0
# Max allowed live spread per symbol (pips) and the typical spread used when no live spread is known
MAX_SPREAD_PIPS=EUR/USD:2.0,GBP/USD:2.5,USD/JPY:2.0,XAU/USD:50,default:3.0
TYPICAL_SPREAD_PIPS=EUR/USD:1.0,GBP/USD:1.5,USD/JPY:1.2,XAU/USD:30,default:2.0
# Setup types to use (range_reversal is off by default)
INTRADAY_SETUPS_ENABLED=trend_pullback,squeeze_breakout,range_breakout,asian_range_breakout,bos_retest
# No new trades for the rest of the day after this many stop-loss hits
DAILY_LOSS_LIMIT=2
# A plan that isn't entered within this many 15-minute candles expires
INTRADAY_PLAN_EXPIRY_BARS=8
# Seconds after each 15-minute close before the plans are re-run (lets the data arrive)
INTRADAY_REFRESH_DELAY_S=20

# ---------------- Misc ----------------
LOG_LEVEL=INFO
